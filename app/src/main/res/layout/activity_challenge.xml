<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/guard_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="64dp">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/challenge_title"
        android:textColor="@color/guard_accent"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/tv_question"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="28dp"
        android:text=""
        android:textColor="@color/guard_text"
        android:textSize="56sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text=""
        android:textColor="@color/guard_danger"
        android:textSize="40sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_reveal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:text=""
        android:textColor="@color/guard_ok"
        android:textSize="30sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/opt0"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_option"
            android:focusable="true"
            android:text=""
            android:textColor="@color/guard_text"
            android:textSize="26sp" />

        <Button
            android:id="@+id/opt1"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_option"
            android:focusable="true"
            android:text=""
            android:textColor="@color/guard_text"
            android:textSize="26sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/opt2"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_option"
            android:focusable="true"
            android:text=""
            android:textColor="@color/guard_text"
            android:textSize="26sp" />

        <Button
            android:id="@+id/opt3"
            android:layout_width="0dp"
            android:layout_height="96dp"
            android:layout_margin="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_option"
            android:focusable="true"
            android:text=""
            android:textColor="@color/guard_text"
            android:textSize="26sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="@string/challenge_sub"
        android:textColor="@color/guard_text_dim"
        android:textSize="16sp" />
</LinearLayout>
