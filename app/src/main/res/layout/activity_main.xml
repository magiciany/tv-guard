<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/guard_bg"
    android:padding="48dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textColor="@color/guard_text"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:text="@string/subtitle"
            android:textColor="@color/guard_text_dim"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_target"
            style="@style/GuardButton"
            android:text="@string/label_target" />

        <Button
            android:id="@+id/btn_type"
            style="@style/GuardButton"
            android:text="@string/label_type" />

        <Button
            android:id="@+id/btn_interval"
            style="@style/GuardButton"
            android:text="@string/label_interval" />

        <Button
            android:id="@+id/btn_lock"
            style="@style/GuardButton"
            android:text="@string/label_lock" />

        <Button
            android:id="@+id/btn_diff"
            style="@style/GuardButton"
            android:text="@string/label_diff" />

        <Button
            android:id="@+id/btn_access"
            style="@style/GuardButton"
            android:text="@string/label_access" />

        <Button
            android:id="@+id/btn_overlay"
            style="@style/GuardButton"
            android:text="@string/label_overlay" />

        <Button
            android:id="@+id/btn_stats"
            style="@style/GuardButton"
            android:text="@string/label_stats" />

        <Button
            android:id="@+id/btn_pin"
            style="@style/GuardButton"
            android:text="@string/label_pin" />

        <Button
            android:id="@+id/btn_power"
            style="@style/GuardButton"
            android:text="@string/label_power" />

        <Button
            android:id="@+id/btn_test"
            style="@style/GuardButton"
            android:text="@string/label_test" />

        <TextView
            android:id="@+id/tv_diag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="自检：—"
            android:textColor="@color/guard_accent"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/hint"
            android:textColor="@color/guard_text_dim"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
