<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/guard_bg"
    android:orientation="vertical"
    android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/picker_title"
        android:textColor="@color/guard_text"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="@string/picker_hint"
        android:textColor="@color/guard_text_dim"
        android:textSize="14sp" />

    <ListView
        android:id="@+id/list_apps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="#22FFFFFF"
        android:dividerHeight="1dp"
        android:listSelector="@drawable/bg_button"
        android:scrollbars="vertical" />
</LinearLayout>
